                <div class="w-20 h-1.5 gradient-primary mx-auto rounded-full"></div>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Feature 1: Image Transliteration -->
                <div class="bg-background rounded-3xl p-8 hover:bg-primary-light/30 transition-colors duration-300 group cursor-pointer border border-transparent hover:border-primary-light">
                    <div class="w-16 h-16 rounded-2xl bg-orange-100 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                    <h3 class="font-display text-xl font-bold text-gray-900 mb-3">Transliterasi Gambar</h3>
                    <p class="text-gray-500 leading-relaxed">Ubah foto manuskrip pegon menjadi teks latin digital yang jernih dan dapat dibaca dengan mudah dalam hitungan detik.</p>
                </div>

                <!-- Feature 2: Text Transliteration -->
                <div class="bg-background rounded-3xl p-8 hover:bg-primary-light/30 transition-colors duration-300 group cursor-pointer border border-transparent hover:border-primary-light">
                    <div class="w-16 h-16 rounded-2xl bg-teal-100 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    </div>
                    <h3 class="font-display text-xl font-bold text-gray-900 mb-3">Transliterasi Teks</h3>
                    <p class="text-gray-500 leading-relaxed">Ketik dalam Latin, keluar dalam Pegon. Konsisten dalam penggunaan harakat maupun tidak.</p>
                </div>

                <!-- Feature 3: Learning -->
                <div class="bg-background rounded-3xl p-8 hover:bg-primary-light/30 transition-colors duration-300 group cursor-pointer border border-transparent hover:border-primary-light">
