<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pegon AI - Aplikasi Transliterasi & Belajar Aksara Pegon Terbaik</title>
    <meta name="description" content="Aplikasi No.1 untuk ubah Latin ke Pegon dan Pegon ke Latin secara instan dengan AI. Fitur lengkap: Scan OCR foto kitab/tulisan tangan/manuskrip kuno menjadi teks latin digital, dan gamifikasi belajar aksara. Solusi digital terbaik untuk santri, akademisi, dan pelestari budaya.">
    <meta name="keywords" content="pegon, pegon ai, aplikasi pegon, transliterasi pegon, latin ke pegon, pegon ke latin, translate pegon, kamus pegon, keyboard pegon, arab jawa, arab melayu, huruf jawi, tulisan arab melayu, scan pegon, ocr pegon, foto jadi teks pegon, belajar nulis pegon, santri, pesantren, kitab kuning, makna gandul, makna pesantren, nu, muhammadiyah, digitalisasi manuskrip, ai islam, teknologi pesantren, pegonku alternatif, asbab pegon alternatif">
    <meta name="author" content="Tim Pegon AI">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://pegon.ai/">
    <meta property="og:title" content="Pegon AI - Aplikasi Transliterasi & Belajar Aksara Pegon Terbaik">
    <meta property="og:description" content="Ubah Latin ke Pegon & sebaliknya dalam hitungan detik. Dilengkapi OCR AI untuk scan foto dan fitur belajar interaktif. Download sekarang!">
    <meta property="og:image" content="https://pegon.ai/static/images/logo.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://pegon.ai/">
    <meta property="twitter:title" content="Pegon AI - Aplikasi Transliterasi & Belajar Aksara Pegon Terbaik">
    <meta property="twitter:description" content="Ubah Latin ke Pegon & sebaliknya dalam hitungan detik. Dilengkapi OCR AI untuk scan foto dan fitur belajar interaktif.">
    <meta property="twitter:image" content="https://pegon.ai/static/images/logo.png">
    
    <link rel="canonical" href="https://pegon.ai/">
    <link rel="icon" type="image/webp" href="/static/images/navbar.webp">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            DEFAULT: '#009688', // The main Teal color from screenshots
                            dark: '#0f766e',
                            light: '#e0f2f1',
                        },
                        accent: {
                            DEFAULT: '#fbbf24', // The Amber/Yellow from premium/status cards
                            hover: '#f59e0b',
                        },
                        surface: '#ffffff',
                        background: '#fffbf2', // Very light cream background
                    },
                    fontFamily: {
                        sans: ['"Inter"', 'sans-serif'],
                        display: ['"Outfit"', 'sans-serif'],
                    },
                    boxShadow: {
                        'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                        'card': '0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025)',
                    }
                }
            }
        }
    </script>
    
    <style>
        .gradient-primary {
            background: linear-gradient(135deg, #009688 0%, #0d9488 100%);
        }
        .gradient-accent {
            background: linear-gradient(135deg, #f97316 0%, #eab308 100%);
        }
        .gradient-gold {
            background: linear-gradient(135deg, #FFD700 0%, #FDB931 100%); /* Gold rope texture match */
        }
        /* Login Screen Aesthetic Match */
        .aesthetic-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -50;
            overflow: hidden;
            background-color: #ffffff;
        }
        .soft-shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.6;
        }
        /* Top Right Cream/Yellow Shape */
        .shape-cream {
            top: -10%;
            right: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #FEF3C7; /* Soft Amber/Cream */
        }
        /* Bottom Left Teal Shape */
        .shape-teal {
            bottom: -10%;
            left: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #E0F7FA; /* Soft Teal */
        }

        .gold-border-text {
             text-shadow: 2px 2px 0px #FDB931;
        }
    </style>
</head>
<body class="bg-transparent font-sans text-gray-800 antialiased selection:bg-yellow-200 selection:text-black">

