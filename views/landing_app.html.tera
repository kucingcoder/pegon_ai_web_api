                             <span class="text-gray-700 font-medium text-lg">Sesuai kaidah linguistik</span>
                         </li>
                         <li class="flex items-center gap-4 group">
                             <div class="w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-primary text-sm font-bold group-hover:bg-primary group-hover:text-white transition-colors">✓</div>
                             <span class="text-gray-700 font-medium text-lg">Konsistensi dalam penggunaan harakat</span>
                         </li>
                         <li class="flex items-center gap-4 group">
                             <div class="w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-primary text-sm font-bold group-hover:bg-primary group-hover:text-white transition-colors">✓</div>
                             <span class="text-gray-700 font-medium text-lg">Terintegrasi dengan Microsoft Word</span>
                         </li>
                     </ul>
                 </div>
            </div>
        </div>
    </section>

    <!-- Gamification / Learning (Level Up Style) -->
    <section class="py-24 bg-surface relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="bg-gradient-to-r from-teal-500 via-teal-600 to-teal-800 rounded-[3rem] p-8 lg:p-24 text-white shadow-2xl relative overflow-hidden group">
                <!-- Decorative Circles -->
                <div class="absolute top-0 right-0 w-96 h-96 bg-white opacity-10 rounded-full blur-3xl transform translate-x-1/3 -translate-y-1/3 group-hover:scale-110 transition-transform duration-1000"></div>
                <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent opacity-20 rounded-full blur-3xl transform -translate-x-1/3 translate-y-1/3 group-hover:scale-110 transition-transform duration-1000"></div>

                <div class="grid lg:grid-cols-2 gap-16 items-center relative z-10">
                    <div>
                         <span class="bg-white/20 px-5 py-2 rounded-full text-sm font-bold tracking-wide uppercase mb-8 inline-block backdrop-blur-md border border-white/20 shadow-lg">Pembelajaran Super Interaktif</span>
                         <h2 class="font-display text-4xl lg:text-5xl font-bold mb-8 leading-tight">Belajar Jadi Lebih <br> <span class="text-accent">Menyenangkan</span></h2>
                         <p class="text-teal-50 text-xl mb-10 leading-relaxed max-w-lg">
                             Selesaikan materi, kerjakan tes dengan verifikasi berbasis AI, dan naikan stage atau level. Sistem kami dirancang agar Anda termotivasi untuk terus belajar serta mampu memverifikasi bacaan dan tulisan tangan anda.
                         </p>
                         
                         <!-- Stats Mockup -->
                         <div class="flex gap-6 max-w-md">
                             <div class="bg-white/10 backdrop-blur-md p-5 rounded-3xl border border-white/10 flex-1 hover:bg-white/20 transition-colors">
                                 <div class="text-4xl font-bold text-accent mb-2">XP</div>
                                 <div class="text-sm text-teal-100 font-medium">Experience Points</div>
                             </div>
                             <div class="bg-white/10 backdrop-blur-md p-5 rounded-3xl border border-white/10 flex-1 hover:bg-white/20 transition-colors">
                                 <div class="text-4xl font-bold text-accent mb-2">Lvl 3</div>
                                 <div class="text-sm text-teal-100 font-medium">Mastery Level</div>
                             </div>
                         </div>
                    </div>

                    <!-- Level Card Mockup (Matching Screenshot) -->
