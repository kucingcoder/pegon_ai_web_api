                        <div class="bg-white text-gray-800 p-8 rounded-[3rem] shadow-2xl transform lg:rotate-3 hover:rotate-0 transition-all duration-500 border-4 border-white/50 relative z-10">
                            <div class="flex justify-between items-center mb-8">
                                <div>
                                    <h3 class="font-bold text-gray-400 text-sm uppercase tracking-wider mb-1">Status Belajar</h3>
                                    <div class="text-4xl font-display font-bold text-gray-900">Santri Pemula</div>
                                </div>
                                <div class="flex gap-1 text-accent drop-shadow-sm">
                                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                </div>
                            </div>
                            
                            <!-- Progress Bar -->
                            <div class="relative py-2 mb-6">
                                <div class="flex justify-between text-sm font-bold text-gray-600 mb-2">
                                    <span>Level 8</span>
                                    <span>75%</span>
                                </div>
                                <div class="h-4 bg-gray-100 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-orange-500 to-yellow-500 w-3/4 rounded-full shadow-lg relative overflow-hidden">
                                        <div class="absolute inset-0 bg-white/20"></div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-4">
                                <div class="bg-gray-50 rounded-3xl p-6 flex flex-col items-center text-center gap-3 hover:bg-teal-50 transition-colors cursor-pointer group/item">
                                    <div class="w-12 h-12 rounded-full bg-white shadow-sm flex items-center justify-center text-2xl group-hover/item:scale-110 transition-transform">📖</div>
                                    <span class="text-sm font-bold text-gray-700">Membaca</span>
