<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fitur Pegon AI - Scan Foto, Transliterasi & Belajar</title>
    <meta name="description" content="Satu aplikasi untuk semua kebutuhan Pegon: 1) Scan foto kitab/tulisan tangan jadi teks latin digital (OCR), 2) Convert Latin ke Pegon otomatis, 3) Belajar baca tulis Pegon dengan game seru. Teknologi AI tercanggih untuk santri dan umum.">
    <meta name="keywords" content="scan pegon, foto ke teks pegon, ocr kitab kuning, transliterasi latin pegon, convert pegon online, belajar aksara arab, game edukasi islam, keyboard arab pegon, nulis pegon di hp, aplikasi santri, baca kitab gundul, teknologi pesantren, pegon translator">
    <meta name="author" content="Tim Pegon AI">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://pegon.ai/landing/app">
    <meta property="og:title" content="Fitur Pegon AI - Scan Foto, Transliterasi & Belajar">
    <meta property="og:description" content="Scan foto kitab jadi teks, ubah Latin ke Pegon instan, mapun belajar interaktif. Teknologi AI terlengkap." >
    <meta property="og:image" content="https://pegon.ai/static/images/logo.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://pegon.ai/landing/app">
    <meta property="twitter:title" content="Fitur Pegon AI - Scan Foto, Transliterasi & Belajar">
    <meta property="twitter:description" content="Scan foto kitab jadi teks, ubah Latin ke Pegon instan, mapun belajar interaktif. Teknologi AI terlengkap.">
    <meta property="twitter:image" content="https://pegon.ai/static/images/logo.png">

    <link rel="canonical" href="https://pegon.ai/landing/app">
    <link rel="icon" type="image/webp" href="/static/images/navbar.webp">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            DEFAULT: '#009688', // The main Teal color
                            dark: '#0f766e',
                            light: '#e0f2f1',
                        },
                        accent: {
                            DEFAULT: '#fbbf24', // The Amber/Yellow
                            hover: '#f59e0b',
                        },
                        surface: '#ffffff',
                        background: '#fffbf2',
                    },
                    fontFamily: {
                        sans: ['"Inter"', 'sans-serif'],
                        display: ['"Outfit"', 'sans-serif'],
                    },
                    boxShadow: {
                        'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                        'card': '0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025)',
                    }
                }
            }
        }
    </script>

    <style>
        .gradient-primary {
            background: linear-gradient(135deg, #009688 0%, #0d9488 100%);
        }
        .gradient-accent {
            background: linear-gradient(135deg, #f97316 0%, #eab308 100%);
        }

        /* Login Screen Aesthetic Match */
        .aesthetic-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -50;
            overflow: hidden;
            background-color: #ffffff;
        }
        .soft-shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.6;
        }
        /* Top Right Cream/Yellow Shape */
        .shape-cream {
            top: -10%;
            right: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #FEF3C7; /* Soft Amber/Cream */
        }
        /* Bottom Left Teal Shape */
        .shape-teal {
            bottom: -10%;
            left: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #E0F7FA; /* Soft Teal */
        }
    </style>
</head>
<body class="bg-transparent font-sans text-gray-800 antialiased selection:bg-accent selection:text-white">

    <!-- Background Elements -->
    <div class="aesthetic-bg">
        <div class="soft-shape shape-cream"></div>
        <div class="soft-shape shape-teal"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed w-full z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-gray-100/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                    <img src="/static/images/navbar.webp" alt="Pegon AI Logo" class="w-12 h-12 object-contain">
                    <span class="text-gray-900 font-display font-bold text-2xl tracking-tight">PEGON AI</span>
                </a>
                
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-8">
                     <a href="/landing" class="text-gray-500 hover:text-primary font-medium text-sm transition-colors">Beranda</a>
                    <a href="/landing/app" class="text-primary font-semibold text-sm transition-colors border-b-2 border-primary">Aplikasi</a>
                    <a href="/landing/contact" class="text-gray-500 hover:text-primary font-medium text-sm transition-colors">Kontak</a>
                </div>
                
                <!-- Desktop CTA -->
                <div class="hidden md:block">
                     <a href="https://play.google.com" class="gradient-accent text-white font-bold py-2.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-2 text-sm">
                        <img src="/static/images/google_play_icon.webp" class="h-5 w-5 object-contain" alt="Play Store">
                        <span>Unduh Aplikasi</span>
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-gray-600 hover:text-primary focus:outline-none p-2 rounded-lg hover:bg-gray-100 transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Panel -->
        <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-gray-100 absolute inset-x-0 top-20 shadow-xl p-6 flex flex-col gap-4 animate-fade-in-down">
            <a href="/landing" class="text-gray-600 hover:text-primary font-medium text-lg px-4 py-3 rounded-xl hover:bg-gray-50 text-center transition-colors">Beranda</a>
            <a href="/landing/app" class="text-primary font-bold text-lg px-4 py-3 rounded-xl bg-teal-50 text-center">Aplikasi</a>
            <a href="/landing/contact" class="text-gray-600 hover:text-primary font-medium text-lg px-4 py-3 rounded-xl hover:bg-gray-50 text-center transition-colors">Kontak</a>
            <a href="https://play.google.com" class="gradient-accent text-white font-bold py-4 px-6 rounded-xl shadow-lg flex items-center justify-center gap-3 text-base mx-2 mt-2">
                <img src="/static/images/google_play_icon.webp" class="h-6 w-6 object-contain" alt="Play Store">
                <span>Unduh Aplikasi</span>
            </a>
        </div>
    </nav>

    <script>
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        
        if (mobileBtn && mobileMenu) {
            mobileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                mobileMenu.classList.toggle('hidden');
            });

            // Close menu when clicking outside
            document.addEventListener('click', (e) => {
                if (!mobileMenu.classList.contains('hidden') && !mobileMenu.contains(e.target)) {
                    mobileMenu.classList.add('hidden');
                }
            });

            // Close menu on resize
            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768) {
                    mobileMenu.classList.add('hidden');
                }
            });
        }
    </script>

    <!-- Hero Section -->
    <header class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden text-center">
        <!-- Background Decor -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl pointer-events-none">
             <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl animate-pulse delay-700"></div>
             <div class="absolute top-40 right-10 w-96 h-96 bg-accent/10 rounded-full blur-3xl animate-pulse"></div>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full text-sm font-semibold text-primary mb-8 shadow-sm hover:shadow-md transition-all cursor-default">
                <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"></span>
                </span>
                Teknologi Pegon AI v1.0
            </div>
            
            <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-gray-900 tracking-tight leading-tight">
                Teknologi Pelestari <br class="hidden md:block"> 
                <span class="text-transparent bg-clip-text gradient-primary relative">
                    Budaya Bangsa
                    <svg class="absolute w-full h-3 -bottom-1 left-0 text-accent/30 -z-10" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0 5 Q 50 10 100 5 L 100 10 L 0 10 Z" fill="currentColor"></path></svg>
                </span>
            </h1>
            
            <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed mb-10">
                Menjembatani masa lalu yang berharga dengan masa depan yang cerdas melalui aplikasi yang intuitif, akurat, dan mudah digunakan oleh siapa saja.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="https://play.google.com" class="gradient-accent text-white font-bold py-4 px-8 rounded-full shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 flex items-center gap-3 text-lg w-full sm:w-auto justify-center">
                    <img src="/static/images/google_play_icon.webp" class="h-6 w-6 object-contain" alt="Play Store">
                    <span>Unduh Sekarang</span>
                </a>
                <a href="#features" class="bg-white text-gray-700 font-bold py-4 px-8 rounded-full shadow-soft hover:shadow-md border border-gray-100 transition-all hover:-translate-y-1 w-full sm:w-auto justify-center">
                    Pelajari Fitur
                </a>
            </div>
        </div>
    </header>

    <!-- UI Feature Showcase -->
    <section id="features" class="py-24 lg:py-32 bg-white rounded-t-[3rem] shadow-[0_-20px_60px_rgba(0,0,0,0.03)] relative overflow-hidden">
        <!-- Subtle Pattern Background -->
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#009688 1px, transparent 1px); background-size: 32px 32px;"></div>
        
        <div class="max-w-7xl mx-auto px-6 lg:px-8 space-y-32 relative z-10">
            
            <!-- Feature 1: Image Transliteration -->
            <div class="group flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
                <div class="w-full lg:w-1/2">
                     <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-orange-50 text-orange-500 mb-8 shadow-sm group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500 ease-out">
                         <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                     </div>
                     <h2 class="font-display text-4xl lg:text-5xl font-bold text-gray-900 mb-6 tracking-tight">Transliterasi <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500">Gambar (OCR)</span></h2>
                     <p class="text-gray-500 mb-8 leading-relaxed text-lg lg:text-xl font-light">
                         Teknologi AI kami membaca tulisan Pegon dari foto layaknya mata manusia. Dapatkan hasil digital presisi dari naskah kuno atau tulisan tangan dalam hitungan detik.
                     </p>
                     
                     <div class="flex flex-wrap gap-4">
                         <div class="pl-4 pr-6 py-3 rounded-full bg-white border border-gray-100 shadow-sm flex items-center gap-3 transition-colors hover:border-orange-200">
                             <div class="flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                             </div>
                             <span class="font-semibold text-gray-700">Akurasi 95%+</span>
                         </div>
                         <div class="pl-4 pr-6 py-3 rounded-full bg-white border border-gray-100 shadow-sm flex items-center gap-3 transition-colors hover:border-orange-200">
                            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 text-blue-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                             </div>
                             <span class="font-semibold text-gray-700">Proses Kilat</span>
                         </div>
                     </div>
                </div>
                <div class="w-full lg:w-1/2 perspective-1000">
                    <div class="relative group/card transform transition-all duration-700 hover:rotate-y-2 hover:rotate-x-2">
                         <div class="absolute -inset-4 bg-gradient-to-r from-orange-400/30 to-amber-400/30 rounded-[2.5rem] blur-2xl opacity-0 group-hover/card:opacity-100 transition duration-700"></div>
                         <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)] border border-gray-100 bg-white">
                            <img src="/static/images/transliterasi_gambar.webp" alt="Transliterasi Gambar" class="w-full h-auto object-cover transform transition duration-700 group-hover/card:scale-105">
                         </div>
                    </div>
                </div>
            </div>

            <!-- Feature 2: Text Transliteration -->
            <div class="group flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
                 <div class="w-full lg:w-1/2 order-2 lg:order-1 perspective-1000">
                     <div class="relative group/card transform transition-all duration-700 hover:-rotate-y-2 hover:rotate-x-2">
                         <div class="absolute -inset-4 bg-gradient-to-r from-teal-400/30 to-emerald-400/30 rounded-[2.5rem] blur-2xl opacity-0 group-hover/card:opacity-100 transition duration-700"></div>
                         <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)] border border-gray-100 bg-white">
                            <img src="/static/images/transliterasi_teks.webp" alt="Transliterasi Teks" class="w-full h-auto object-cover transform transition duration-700 group-hover/card:scale-105">
                         </div>
                     </div>
                 </div>
                 
                 <div class="w-full lg:w-1/2 order-1 lg:order-2">
                     <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-teal-50 text-teal-600 mb-8 shadow-sm group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-500 ease-out">
                         <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                     </div>
                     <h2 class="font-display text-4xl lg:text-5xl font-bold text-gray-900 mb-6 tracking-tight">Transliterasi <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-emerald-500">Teks Latin</span></h2>
                     <p class="text-gray-500 leading-relaxed text-lg lg:text-xl font-light mb-8">
                        Ketik Latin, keluar Pegon. Solusi menulis Pegon tanpa perlu install keyboard khusus, lengkap dengan harakat yang akurat.
                     </p>
                     
                     <ul class="space-y-4">
                         <li class="flex items-start gap-4">
                             <div class="flex-shrink-0 w-6 h-6 mt-1 rounded-full bg-teal-100 flex items-center justify-center text-teal-600">
                                 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                             </div>
                             <div>
                                 <h4 class="text-gray-900 font-bold">Kaidah Linguistik</h4>
                                 <p class="text-sm text-gray-500">Mengikuti standar penulisan Pegon yang baku.</p>
                             </div>
                         </li>
                         <li class="flex items-start gap-4">
                             <div class="flex-shrink-0 w-6 h-6 mt-1 rounded-full bg-teal-100 flex items-center justify-center text-teal-600">
                                 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                             </div>
                             <div>
                                 <h4 class="text-gray-900 font-bold">Integrasi Word</h4>
                                 <p class="text-sm text-gray-500">Langsung export hasil ke Microsoft Word.</p>
                             </div>
                         </li>
                     </ul>
                 </div>
            </div>

            <!-- Feature 3: Learning (Gamification) -->
            <div class="group flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
                <div class="w-full lg:w-1/2">
                     <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 mb-8 shadow-sm group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500 ease-out">
                         <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                     </div>
                     <div class="flex items-center gap-3 mb-4">
                        <span class="inline-block px-3 py-1 bg-gradient-to-r from-blue-500 to-indigo-500 text-white text-[10px] font-bold uppercase tracking-wider rounded-full shadow-sm">Fitur Baru</span>
                     </div>
                     <h2 class="font-display text-4xl lg:text-5xl font-bold text-gray-900 mb-6 tracking-tight">Belajar <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-indigo-500">Interaktif</span></h2>
                     <p class="text-gray-500 mb-10 leading-relaxed text-lg lg:text-xl font-light">
                         Metode pembelajaran modern dengan sistem gamifikasi. Selesaikan materi, kerjakan tes, dan naikkan level Anda layaknya bermain game.
                     </p>
                     
                     <div class="grid grid-cols-2 gap-4">
                         <div class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                             <div class="text-3xl font-display font-bold text-gray-900 mb-1">XP</div>
                             <div class="text-sm font-medium text-gray-400 uppercase tracking-wide">Sistem Poin</div>
                         </div>
                         <div class="p-6 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                             <div class="text-3xl font-display font-bold text-gray-900 mb-1">Level</div>
                             <div class="text-sm font-medium text-gray-400 uppercase tracking-wide">Progres Bertahap</div>
                         </div>
                     </div>
                </div>
                <div class="w-full lg:w-1/2">
                    <div class="grid grid-cols-2 gap-4 lg:gap-6">
                        <div class="relative group/card mt-8 lg:mt-12 transform transition-all hover:-translate-y-2">
                            <div class="absolute -inset-2 bg-blue-400/20 rounded-2xl blur-xl opacity-0 group-hover/card:opacity-100 transition duration-500"></div>
                            <img src="/static/images/belajar_membaca.webp" class="relative w-full h-auto rounded-2xl shadow-lg border border-gray-100" alt="Belajar Membaca">
                        </div>
                        <div class="relative group/card mb-8 lg:mb-12 transform transition-all hover:-translate-y-2">
                            <div class="absolute -inset-2 bg-indigo-400/20 rounded-2xl blur-xl opacity-0 group-hover/card:opacity-100 transition duration-500"></div>
                            <img src="/static/images/belajar_menulis.webp" class="relative w-full h-auto rounded-2xl shadow-lg border border-gray-100" alt="Belajar Menulis">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Call to Action (Replaces old Gamification Section Style) -->
    <section class="py-24 bg-white relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="bg-gradient-to-br from-teal-600 via-teal-700 to-teal-900 rounded-[3rem] p-8 lg:p-20 text-white shadow-2xl relative overflow-hidden text-center">
                <!-- Decorative BG -->
                <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-white opacity-5 rounded-full blur-[100px] pointer-events-none transform translate-x-1/3 -translate-y-1/3"></div>
                <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-accent opacity-10 rounded-full blur-[80px] pointer-events-none transform -translate-x-1/3 translate-y-1/3"></div>

                <div class="relative z-10 max-w-3xl mx-auto">
                    <h2 class="font-display text-4xl lg:text-6xl font-bold mb-8 leading-tight">Siap Memulai <br> Perjalanan Anda?</h2>
                    <p class="text-teal-100 text-xl mb-12 leading-relaxed font-light">
                        Jadilah bagian dari gerakan pelestarian budaya. Unduh Pegon AI sekarang dan rasakan kemudahan teknologi dalam genggaman.
                    </p>
                    
                    <a target="_blank" href="https://play.google.com" class="gradient-accent text-white font-bold py-4 px-10 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 inline-flex items-center gap-3 text-lg group">
                        <img src="/static/images/google_play_icon.webp" class="h-6 w-6 object-contain transition-transform group-hover:scale-110" alt="Play Store">
                        <span>Unduh Aplikasi</span>
                    </a>
                </div>
            </div>
        </div>
