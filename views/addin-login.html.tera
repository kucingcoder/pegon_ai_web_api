<!DOCTYPE html>

<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masuk - Pegon AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script> tailwind.config = { theme: { extend: { colors: { primary: '#06b6d4', secondary: '#ecfeff', }, animation: { 'shake': 'shake 0.82s cubic-bezier(.36,.07,.19,.97) both', }, keyframes: { shake: { '10%, 90%': { transform: 'translate3d(-1px, 0, 0)' }, '20%, 80%': { transform: 'translate3d(2px, 0, 0)' }, '30%, 50%, 70%': { transform: 'translate3d(-4px, 0, 0)' }, '40%, 60%': { transform: 'translate3d(4px, 0, 0)' } } } } } } </script>
</head>

<body class="bg-gray-50 flex items-center justify-center min-h-screen font-sans">
    <main class="w-full max-w-sm p-4 space-y-4">
        <form action="/add-in/login/add-in-auth-handle" method="POST" class="w-full">
            <div class="bg-white rounded-3xl shadow shadow-lg border border-2 border-gray-300 p-5 relative">
                <div class="flex flex-col items-center justify-center mb-3">
                    <div class="p-3 bg-white rounded-full border border-cyan-100 shadow-sm mb-3">
                        <svg xmlns="[http://www.w3.org/2000/svg](http://www.w3.org/2000/svg)" fill="none" viewBox="0 0 24 24"
                            stroke-width="2" stroke="currentColor" class="w-8 h-8 text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                    </div>
                    <h3 class="text-gray-900 font-bold text-xl">Pegon AI</h3>
                    <p class="text-gray-500 text-sm mt-1">Masuk dengan Kode Add-in</p>
                </div>

                {% if error %}
                <div class="mb-4 animate-shake">
                    <div
                        class="flex items-center gap-2 p-3 bg-red-50 border border-red-200 rounded-2xl text-red-600 text-sm">
                        <svg xmlns="[http://www.w3.org/2000/svg](http://www.w3.org/2000/svg)" viewBox="0 0 20 20"
                            fill="currentColor" class="w-5 h-5 flex-shrink-0">
                            <path fill-rule="evenodd"
                                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z"
                                clip-rule="evenodd" />
                        </svg>
                        <span>{{ error }}</span>
                    </div>
                </div>
                {% endif %}

                <input type="text" name="add_in_code" id="add_in_code" placeholder="Masukkan kode di sini..."
                    class="w-full text-gray-600 placeholder-gray-400 outline-none text-lg bg-gray-50 rounded-xl px-4 py-3 border border-gray-200 focus:border-primary focus:ring-1 focus:ring-primary transition-all">

                <button type="submit"
                    class="mt-6 w-full bg-primary hover:bg-cyan-600 text-white font-bold py-2 rounded-2xl shadow shadow-lg shadow-cyan-200 transition transform active:scale-95 flex justify-center items-center gap-2 text-lg">
                    Masuk
                </button>
            </div>
        </form>
    </main>
</body>

</html>