<!DOCTYPE html>
<html lang="id" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kebijakan Privasi - Pegon AI</title>
    <meta name="description" content="Kebijakan Privasi Pegon AI menjelaskan bagaimana kami mengumpulkan, menggunakan, dan melindungi data pribadi Anda saat menggunakan layanan kami.">
    <meta name="robots" content="index, follow">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://pegon.ai/landing/privacy">
    <meta property="og:title" content="Kebijakan Privasi - Pegon AI">
    <meta property="og:description" content="Komitmen kami untuk melindungi privasi dan data pribadi pengguna Pegon AI.">
    <meta property="og:image" content="https://pegon.ai/static/images/logo.png">
    <link rel="icon" type="image/webp" href="/static/images/navbar.webp">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            DEFAULT: '#009688',
                            dark: '#0f766e',
                            light: '#e0f2f1',
                        },
                        accent: {
                            DEFAULT: '#fbbf24',
                            hover: '#f59e0b',
                        },
                        surface: '#ffffff',
                        background: '#fffbf2',
                    },
                    fontFamily: {
                        sans: ['"Inter"', 'sans-serif'],
                        display: ['"Outfit"', 'sans-serif'],
                    },
                    boxShadow: {
                        'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                        'card': '0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025)',
                    },
                    keyframes: {
                        'fade-in-down': {
                            '0%': {
                                opacity: '0',
                                transform: 'translateY(-10px)'
                            },
                            '100%': {
                                opacity: '1',
                                transform: 'translateY(0)'
                            },
                        }
                    },
                    animation: {
                        'fade-in-down': 'fade-in-down 0.5s ease-out'
                    }
                }
            }
        }
    </script>
    <style>
        .gradient-primary {
            background: linear-gradient(135deg, #009688 0%, #0d9488 100%);
        }
        .gradient-accent {
            background: linear-gradient(135deg, #f97316 0%, #eab308 100%);
        }
        /* Login Screen Aesthetic Match */
        .aesthetic-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -50;
            overflow: hidden;
            background-color: #ffffff;
        }
        .soft-shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.6;
        }
        /* Top Right Cream/Yellow Shape */
        .shape-cream {
            top: -10%;
            right: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #FEF3C7; /* Soft Amber/Cream */
        }
        /* Bottom Left Teal Shape */
        .shape-teal {
            bottom: -10%;
            left: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #E0F7FA; /* Soft Teal */
        }
    </style>
</head>
<body class="bg-transparent font-sans text-gray-800 antialiased selection:bg-accent selection:text-white flex flex-col min-h-screen overflow-x-hidden">

    <!-- Background Elements -->
    <div class="aesthetic-bg">
        <div class="soft-shape shape-cream"></div>
        <div class="soft-shape shape-teal"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed w-full z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-gray-100/50">
        <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
            <div class="flex items-center justify-between h-20">
                <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                    <img src="/static/images/navbar.webp" alt="Pegon AI Logo" class="w-12 h-12 object-contain">
                    <span class="text-gray-900 font-display font-bold text-2xl tracking-tight">PEGON AI</span>
                </a>
                
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-8">
                     <a href="/landing" class="text-gray-500 hover:text-primary font-medium text-sm transition-colors">Beranda</a>
                    <a href="/landing/app" class="text-gray-500 hover:text-primary font-medium text-sm transition-colors">Aplikasi</a>
                    <a href="/landing/contact" class="text-gray-500 hover:text-primary font-medium text-sm transition-colors">Kontak</a>
                </div>
                
                <!-- Desktop CTA -->
                <div class="hidden md:block">
                     <a href="https://play.google.com" class="gradient-accent text-white font-bold py-2.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-2 text-sm">
                        <img src="/static/images/google_play_icon.webp" class="h-5 w-5 object-contain" alt="Play Store">
                        <span>Unduh Aplikasi</span>
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-gray-600 hover:text-primary focus:outline-none p-2 rounded-lg hover:bg-gray-100 transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Panel -->
        <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-gray-100 absolute inset-x-0 top-20 shadow-xl p-6 flex flex-col gap-4 animate-fade-in-down">
            <a href="/landing" class="text-gray-600 hover:text-primary font-medium text-lg px-4 py-3 rounded-xl hover:bg-gray-50 text-center transition-colors">Beranda</a>
            <a href="/landing/app" class="text-gray-600 hover:text-primary font-medium text-lg px-4 py-3 rounded-xl hover:bg-gray-50 text-center transition-colors">Aplikasi</a>
            <a href="/landing/contact" class="text-gray-600 hover:text-primary font-medium text-lg px-4 py-3 rounded-xl hover:bg-gray-50 text-center transition-colors">Kontak</a>
            <a href="https://play.google.com" class="gradient-accent text-white font-bold py-4 px-6 rounded-xl shadow-lg flex items-center justify-center gap-3 text-base mx-2 mt-2">
                <img src="/static/images/google_play_icon.webp" class="h-6 w-6 object-contain" alt="Play Store">
                <span>Unduh Aplikasi</span>
            </a>
        </div>
    </nav>

    <script>
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        
        if (mobileBtn && mobileMenu) {
            mobileBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Close menu when clicking outside
            document.addEventListener('click', (e) => {
                if (!mobileMenu.classList.contains('hidden') && 
                    !mobileMenu.contains(e.target) && 
                    !mobileBtn.contains(e.target)) {
                    mobileMenu.classList.add('hidden');
                }
            });

            // Close menu on resize
            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768) {
                    mobileMenu.classList.add('hidden');
                }
            });
        }
    </script>

    <!-- Header / Title -->
    <header class="relative pt-40 pb-12 lg:pt-48 lg:pb-16 text-center px-6">
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">Kebijakan Privasi</h1>
        <p class="text-gray-500 text-lg max-w-2xl mx-auto">
            Kami menghargai privasi Anda dan berkomitmen untuk melindungi data pribadi Anda.
        </p>
        <p class="text-sm text-gray-400 mt-4">Terakhir diperbarui: 16 Februari 2026</p>
    </header>

    <!-- Content -->
    <main class="max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 pb-24">
        <div class="bg-white p-6 md:p-8 lg:p-12 rounded-[2.5rem] shadow-soft border border-gray-100 prose prose-teal md:prose-lg max-w-none break-words">
            
            <section class="mb-10">
                <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">1. Pendahuluan</h2>
                <p class="text-gray-600 leading-relaxed">
                    Pegon AI adalah aplikasi yang didedikasikan untuk melestarikan dan memodernisasi penggunaan aksara Pegon. Kebijakan Privasi ini menjelaskan bagaimana kami mengumpulkan, menggunakan, dan melindungi informasi Anda saat menggunakan aplikasi dan layanan kami.
                </p>
                <p class="text-gray-600 leading-relaxed mt-4">
                    Dengan menggunakan aplikasi Pegon AI, Anda menyetujui praktik data yang dijelaskan dalam kebijakan ini.
                </p>
            </section>

            <section class="mb-10">
                <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">2. Informasi yang Kami Kumpulkan</h2>
                <div class="space-y-4 text-gray-600">
                    <p><strong>a. Informasi Akun</strong><br>
                    Saat Anda mendaftar, kami mengumpulkan informasi dasar seperti nama, alamat email, dan foto profil (melalui Google sign-in) untuk membuat akun Anda.</p>
                    
                    <p><strong>b. Data Gambar dan Teks</strong><br>
                    Untuk fitur transliterasi, kami memproses gambar (manuskrip/tulisan tangan) dan teks yang Anda unggah. Data ini diproses oleh server AI kami untuk menghasilkan transliterasi.</p>
                    
                    <p><strong>c. Data Penggunaan</strong><br>
                    Kami mengumpulkan data tentang bagaimana Anda berinteraksi dengan fitur aplikasi, seperti frekuensi penggunaan fitur transliterasi untuk meningkatkan kualitas layanan.</p>
                </div>
            </section>

            <section class="mb-10">
                <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">3. Penggunaan Data</h2>
                <ul class="list-disc pl-5 space-y-2 text-gray-600">
                    <li>Menyediakan dan mengelola layanan transliterasi dan pembelajaran Pegon.</li>
                    <li>Meningkatkan akurasi model AI transliterasi kami (dengan data yang telah dianonimisasi).</li>
                    <li>Mengirimkan pembaruan terkait layanan dan dukungan pelanggan.</li>
                    <li>Mencegah aktivitas penipuan atau penyalahgunaan aplikasi.</li>
                </ul>
            </section>

            <section class="mb-10">
                <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">4. Keamanan Data</h2>
                <p class="text-gray-600 leading-relaxed">
                    Kami menerapkan langkah-langkah keamanan teknis yang wajar untuk melindungi data Anda dari akses, penggunaan, atau pengungkapan yang tidak sah. Transmisi data dilakukan melalui protokol aman (HTTPS/SSL). Namun, perlu diingat bahwa tidak ada metode transmisi atau penyimpanan data elektronik yang 100% aman.
                </p>
            </section>

            <section class="mb-10">
                <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">5. Layanan Pihak Ketiga</h2>
                <p class="text-gray-600 leading-relaxed">
                    Aplikasi kami menggunakan layanan pihak ketiga yaitu Google OAuth (untuk otentikasi), Google AdMob (untuk periklanan), Midtrans (untuk pembayaran melalui QRIS). Layanan ini mungkin mengumpulkan informasi sesuai dengan kebijakan privasi mereka sendiri. Tautan ke kebijakan privasi penyedia layanan pihak ketiga yang digunakan oleh aplikasi:
                </p>
                <ul class="list-disc pl-5 mt-2 space-y-1 text-gray-600">
                    <li><a target="_blank" href="https://developers.google.com/identity/protocols/oauth2/policies" class="text-primary hover:underline">Google OAuth</a></li>
                    <li><a target="_blank" href="https://transparency.google/intl/en/our-policies/product-terms/google-admob" class="text-primary hover:underline">Google AdMob</a></li>
                    <li><a target="_blank" href="https://midtrans.com/privacy-notice" class="text-primary hover:underline">Midtrans</a></li>
                </ul>
            </section>

            <section class="mb-10">
                <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">6. Hak Pengguna</h2>
                <p class="text-gray-600 leading-relaxed">
                    Anda memiliki hak untuk meminta akses, koreksi, atau penghapusan data pribadi Anda yang tersimpan di sistem kami. Untuk mengajukan permintaan ini, silakan hubungi tim dukungan kami melalui kontak yang tersedia.
                </p>
            </section>

            <section class="mb-10">
                <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">7. Hubungi Kami</h2>
                <p class="text-gray-600 leading-relaxed">
                    Jika Anda memiliki pertanyaan atau saran mengenai Kebijakan Privasi ini, jangan ragu untuk menghubungi kami di:
                </p>
                <div class="mt-4 p-6 bg-teal-50 rounded-2xl border border-teal-100 flex items-center gap-4">
                     <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-primary shadow-sm">
                         <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                     </div>
                     <div>
                         <p class="text-xs font-bold text-gray-500 uppercase">Email</p>
                         <a href="mailto:support@pegon.ai" class="text-lg font-bold text-gray-900 hover:text-primary transition-colors">support@pegon.ai</a>
                     </div>
                </div>
            </section>

        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-50 pt-16 pb-12 border-t border-gray-200 mt-auto">
        <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                <!-- Brand -->
                <div class="col-span-1 md:col-span-2">
                     <a href="/" class="flex items-center gap-2 mb-6">
                        <img src="/static/images/navbar.webp" alt="Pegon AI Logo" class="w-10 h-10 object-contain">
                        <span class="text-gray-900 font-display font-bold text-xl tracking-tight">PEGON AI</span>
                    </a>
                    <p class="text-gray-500 text-sm leading-relaxed max-w-sm">
                        Melestarikan warisan budaya nusantara melalui kecerdasan buatan. Jembatan antara masa lalu yang berharga dan masa depan yang cerdas.
                    </p>
                </div>
                
                <!-- Quick Links -->
                <div>
                    <h4 class="font-bold text-gray-900 mb-6">Navigasi</h4>
                    <ul class="space-y-4 text-sm text-gray-500">
                         <li><a href="/landing" class="hover:text-primary transition-colors">Beranda</a></li>
                        <li><a href="/landing/app" class="hover:text-primary transition-colors">Aplikasi</a></li>
                        <li><a href="/landing/contact" class="hover:text-primary transition-colors">Kontak</a></li>
                    </ul>
                </div>
                
                 <!-- Legal -->
                <div>
                     <h4 class="font-bold text-gray-900 mb-6">Legal</h4>
                    <ul class="space-y-4 text-sm text-gray-500">
                         <li><a href="/landing/privacy" class="text-primary font-bold transition-colors">Kebijakan Privasi</a></li>
<li><a href="/landing/terms" class="hover:text-primary transition-colors">Syarat & Ketentuan</a></li>
<li><a href="/landing/license" class="hover:text-primary transition-colors">Lisensi</a></li>
                    </ul>
                </div>
            </div>
            
            <!-- Bottom Bar -->
             <div class="pt-8 border-t border-gray-200 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-gray-400 text-sm text-center md:text-left">© 2026 Pegon AI. Made with istiqomah for History.</p>
                
                <!-- Socials -->
                <div class="flex space-x-4">
                     <a href="https://www.instagram.com/pegon.ai" target="_blank" class="text-gray-400 hover:text-primary transition-colors p-2 hover:bg-teal-50 rounded-full">
                        <span class="sr-only">Instagram</span>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></path></svg>
                     </a>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
