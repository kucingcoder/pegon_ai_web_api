<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hubungi Kami - Pegon AI</title>
    <meta name="description" content="Hubungi tim Pegon AI untuk pertanyaan, dukungan, atau kolaborasi. Bersama melestarikan warisan budaya nusantara dengan teknologi.">
    <meta name="keywords" content="kontak pegon ai, dukungan pegon ai, call center pegon, alamat pegon ai, kerjasama pegon, email support pegon">
    <meta name="author" content="Tim Pegon AI">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://pegon.ai/landing/contact">
    <meta property="og:title" content="Hubungi Kami - Pegon AI">
    <meta property="og:description" content="Tim Pegon AI siap membantu Anda dalam pelestarian budaya melalui teknologi.">
    <meta property="og:image" content="https://pegon.ai/static/images/logo.png">

    <link rel="canonical" href="https://pegon.ai/landing/contact">
    <link rel="icon" type="image/png" href="/static/images/logo.webp">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            DEFAULT: '#009688',
                            dark: '#0f766e',
                            light: '#e0f2f1',
                        },
                        accent: {
                            DEFAULT: '#fbbf24',
                            hover: '#f59e0b',
                        },
                        surface: '#ffffff',
                        background: '#fffbf2',
                    },
                    fontFamily: {
                        sans: ['"Inter"', 'sans-serif'],
                        display: ['"Outfit"', 'sans-serif'],
                    },
                    boxShadow: {
                        'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                        'card': '0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025)',
                    }
                }
            }
        }
    </script>
    <style>
        .gradient-primary {
            background: linear-gradient(135deg, #009688 0%, #0d9488 100%);
        }
        .gradient-accent {
            background: linear-gradient(135deg, #f97316 0%, #eab308 100%);
        }
        /* Login Screen Aesthetic Match */
        .aesthetic-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -50;
            overflow: hidden;
            background-color: #ffffff;
        }
        .soft-shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.6;
        }
        /* Top Right Cream/Yellow Shape */
        .shape-cream {
            top: -10%;
            right: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #FEF3C7; /* Soft Amber/Cream */
        }
        /* Bottom Left Teal Shape */
        .shape-teal {
            bottom: -10%;
            left: -10%;
            width: 80vw;
            height: 80vw;
            background-color: #E0F7FA; /* Soft Teal */
        }
    </style>
</head>
<body class="bg-transparent font-sans text-gray-800 antialiased selection:bg-accent selection:text-white flex flex-col min-h-screen">

    <!-- Background Elements -->
    <div class="aesthetic-bg">
        <div class="soft-shape shape-cream"></div>
        <div class="soft-shape shape-teal"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed w-full z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-gray-100/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                    <img src="/static/images/logo.webp" alt="Pegon AI Logo" class="w-12 h-12 object-contain">
                    <span class="text-gray-900 font-display font-bold text-2xl tracking-tight">PEGON AI</span>
                </a>
                
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-8">
                     <a href="/landing" class="text-gray-500 hover:text-primary font-medium text-sm transition-colors">Beranda</a>
                    <a href="/landing/app" class="text-gray-500 hover:text-primary font-medium text-sm transition-colors">Aplikasi</a>
                    <a href="/landing/contact" class="text-primary font-semibold text-sm transition-colors border-b-2 border-primary">Kontak</a>
                </div>
                
                <!-- Desktop CTA -->
                <div class="hidden md:block">
                     <a href="https://play.google.com" class="gradient-accent text-white font-bold py-2.5 px-6 rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-2 text-sm">
                        <img src="/static/images/google_play_icon.webp" class="h-5 w-5 object-contain" alt="Play Store">
                        <span>Unduh Aplikasi</span>
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-gray-600 hover:text-primary focus:outline-none p-2 rounded-lg hover:bg-gray-100 transition-colors">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Panel -->
        <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-gray-100 absolute inset-x-0 top-20 shadow-xl p-6 flex flex-col gap-4 animate-fade-in-down">
            <a href="/landing" class="text-gray-600 hover:text-primary font-medium text-lg px-4 py-3 rounded-xl hover:bg-gray-50 text-center transition-colors">Beranda</a>
            <a href="/landing/app" class="text-gray-600 hover:text-primary font-medium text-lg px-4 py-3 rounded-xl hover:bg-gray-50 text-center transition-colors">Aplikasi</a>
            <a href="/landing/contact" class="text-primary font-bold text-lg px-4 py-3 rounded-xl bg-teal-50 text-center">Kontak</a>
            <a href="https://play.google.com" class="gradient-accent text-white font-bold py-4 px-6 rounded-xl shadow-lg flex items-center justify-center gap-3 text-base mx-2 mt-2">
                <img src="/static/images/google_play_icon.webp" class="h-6 w-6 object-contain" alt="Play Store">
                <span>Unduh Aplikasi</span>
            </a>
        </div>
    </nav>

    <script>
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        
        if (mobileBtn && mobileMenu) {
            mobileBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>

    <!-- Content Wrapper -->
    <main class="flex-grow pt-32 pb-12">
        
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                 <h1 class="font-display text-4xl lg:text-5xl font-bold text-gray-900 mb-4">Hubungi Kami</h1>
                 <p class="text-gray-500 max-w-xl mx-auto">Punya pertanyaan atau masukan? Tim kami siap membantu Anda.</p>
            </div>

            <div class="max-w-3xl mx-auto">
                
                <!-- Contact Info -->
                <div class="bg-white p-8 rounded-[2rem] shadow-soft border border-gray-100">
                     <h3 class="font-display text-2xl font-bold text-gray-900 mb-8 text-center">Informasi Kontak</h3>
                     
                     <div class="space-y-8">
                         <!-- Email -->
                         <div class="flex items-center gap-5 p-4 rounded-2xl hover:bg-gray-50 transition-colors">
                             <div class="w-16 h-16 bg-teal-50 rounded-2xl flex items-center justify-center text-primary shrink-0">
                                 <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                             </div>
                             <div>
                                 <p class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-1">Email Support</p>
                                 <a href="mailto:support@pegon.ai" class="text-xl md:text-2xl font-medium text-gray-900 hover:text-primary transition-colors block">support@pegon.ai</a>
                                 <p class="text-sm text-gray-500 mt-1">Kirimkan pertanyaan atau masukan Anda kapan saja</p>
                             </div>
                         </div>
                         
                         <!-- Socials -->
                         <div class="flex items-center gap-5 p-4 rounded-2xl hover:bg-gray-50 transition-colors">
                             <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center text-orange-500 shrink-0">
                                 <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                             </div>
                             <div class="w-full">
                                 <p class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-2">Sosial Media</p>
                                 <div class="flex gap-4">
                                     <a href="https://www.instagram.com/pegon.ai" target="_blank" class="flex items-center gap-2 px-4 py-2 border border-gray-200 text-gray-600 rounded-xl hover:bg-primary hover:text-white hover:border-primary transition-all">
                                         <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></path></svg>
                                         <span class="font-medium">Instagram</span>
                                     </a>
                                 </div>
                             </div>
                         </div>
                     </div>
                 </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-50 pt-16 pb-12 border-t border-gray-200 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                <!-- Brand -->
                <div class="col-span-1 md:col-span-2">
                     <a href="/" class="flex items-center gap-2 mb-6">
                        <img src="/static/images/logo.webp" alt="Pegon AI Logo" class="w-10 h-10 object-contain">
                        <span class="text-gray-900 font-display font-bold text-xl tracking-tight">PEGON AI</span>
                    </a>
                    <p class="text-gray-500 text-sm leading-relaxed max-w-sm">
                        Melestarikan warisan budaya nusantara melalui kecerdasan buatan. Jembatan antara masa lalu yang berharga dan masa depan yang cerdas.
                    </p>
                </div>
                
                <!-- Quick Links -->
                <div>
                    <h4 class="font-bold text-gray-900 mb-6">Navigasi</h4>
                    <ul class="space-y-4 text-sm text-gray-500">
                         <li><a href="/landing" class="hover:text-primary transition-colors">Beranda</a></li>
                        <li><a href="/landing/app" class="hover:text-primary transition-colors">Aplikasi</a></li>
                        <li><a href="/landing/contact" class="hover:text-primary transition-colors">Kontak</a></li>
                    </ul>
                </div>
                
                 <!-- Legal -->
                <div>
                     <h4 class="font-bold text-gray-900 mb-6">Legal</h4>
                    <ul class="space-y-4 text-sm text-gray-500">
                         <li><a href="/landing/privacy" class="hover:text-primary transition-colors">Kebijakan Privasi</a></li>
<li><a href="/landing/terms" class="hover:text-primary transition-colors">Syarat & Ketentuan</a></li>
<li><a href="/landing/license" class="hover:text-primary transition-colors">Lisensi</a></li>
                    </ul>
                </div>
            </div>
            
            <!-- Bottom Bar -->
             <div class="pt-8 border-t border-gray-200 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-gray-400 text-sm text-center md:text-left">© 2026 Pegon AI. Made with istiqomah for History.</p>
                
                <!-- Socials -->
                <div class="flex space-x-4">
                     <a href="https://www.instagram.com/pegon.ai" target="_blank" class="text-gray-400 hover:text-primary transition-colors p-2 hover:bg-teal-50 rounded-full">
                        <span class="sr-only">Instagram</span>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></path></svg>
                    </a>


                </div>
            </div>
        </div>
    </footer>

</body>
</html>
